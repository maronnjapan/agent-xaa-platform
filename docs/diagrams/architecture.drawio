        <mxCell id="srt" value="sa-agent-runtime (shared)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="420" width="320" height="30" as="geometry" />
