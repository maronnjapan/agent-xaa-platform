        <mxCell id="exec" value="Execution&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1 Agent = 1 Execution of the shared Job definition&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;spacingLeft=14;" vertex="1" parent="1">
