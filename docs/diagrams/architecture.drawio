          <mxGeometry x="790" y="300" width="320" height="66" as="geometry" />
        </mxCell>
        <mxCell id="sop_icon_run" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;fontSize=10;fontColor=#000000;image=data:image/svg+xml,;" vertex="1" parent="1">
