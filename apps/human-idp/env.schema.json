{
  "$id": "human-idp-env",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "PORT",
    "ISSUER",
    "ISSUER_PROFILE",
    "JWKS_BUCKET",
    "JWKS_PUBLIC_BASE_URL",
    "KEY_BUCKET",
    "KMS_SSO_KEY_NAME",
    "SIGNER_MODE",
    "STORE_MODE",
    "FIRESTORE_DATABASE",
    "DPOP_REQUIRED",
    "CLIENT_SECRET_AUTOMATION_APP",
    "CLIENT_SECRET_AGENT_PLATFORM",
    "AUTOMATION_APP_REDIRECT_URI",
    "AGENT_OP_CALLBACK_URI",
    "ACCESS_TOKEN_EXPIRES_IN"
  ],
  "properties": {
    "PORT": { "type": "string", "pattern": "^[0-9]{1,5}$" },
    "ISSUER": { "type": "string", "format": "uri" },
    "ISSUER_PROFILE": { "enum": ["direct", "loadbalancer"] },
    "JWKS_BUCKET": { "type": "string", "minLength": 1 },
    "JWKS_PUBLIC_BASE_URL": { "type": "string", "format": "uri" },
    "KEY_BUCKET": { "type": "string", "minLength": 1 },
    "KMS_SSO_KEY_NAME": { "type": "string", "minLength": 1 },
    "SIGNER_MODE": { "enum": ["local", "kms"] },
    "STORE_MODE": { "enum": ["emulator", "gcp"] },
    "FIRESTORE_DATABASE": { "type": "string", "minLength": 1 },
    "DPOP_REQUIRED": { "enum": ["true", "false"] },
    "CLIENT_SECRET_AUTOMATION_APP": { "type": "string", "minLength": 1 },
    "CLIENT_SECRET_AGENT_PLATFORM": { "type": "string", "minLength": 1 },
    "AUTOMATION_APP_REDIRECT_URI": { "type": "string", "format": "uri" },
    "AGENT_OP_CALLBACK_URI": { "type": "string", "format": "uri" },
    "ACCESS_TOKEN_EXPIRES_IN": { "type": "string", "pattern": "^[0-9]{1,6}$" }
  }
}
