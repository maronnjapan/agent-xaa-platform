{
  "$id": "connector",
  "type": "object",
  "additionalProperties": false,
  "required": ["connector_id", "resource_type", "authorization_audience", "authorization_resource", "status", "risk_level", "tools"],
  "properties": {
    "connector_id": { "enum": ["internal-docs-api", "internal-finance-api", "stub-saas-calendar"] },
    "resource_type": { "enum": ["native_xaa", "oauth_bridge"] },
    "authorization_audience": { "type": "string", "format": "uri" },
    "authorization_resource": { "type": "string", "format": "uri" },
    "bridge_audience": { "type": "string", "format": "uri" },
    "status": { "enum": ["ACTIVE", "DISABLED"] },
    "risk_level": { "enum": ["low", "medium", "high"] },
    "tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "allOf": [
    {
      "if": { "properties": { "resource_type": { "const": "oauth_bridge" } } },
      "then": { "required": ["bridge_audience"], "properties": { "bridge_audience": true } }
    }
  ]
}
